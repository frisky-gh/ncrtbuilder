#!/usr/bin/perl

our $TOOLHOME;
BEGIN {
	$0 =~ m"^(.*)/";
	$TOOLHOME = ` cd "$1/.." && pwd || echo . `;
	chomp $TOOLHOME;
}
our $DAEMONCONFDIR  = "$TOOLHOME/daemonconf";
our $PLUGINSDIR     = "$TOOLHOME/plugins";
our $PLUGINSCONFDIR = "$TOOLHOME/pluginsconf";

use lib "$TOOLHOME/lib/perl5";

use English;
use Socket;
use IO::Handle;
use URI::Escape;
use HTTP::Daemon;
use HTTP::Status;
use LWP::UserAgent;
use IPC::Open2;
use Template;
use IO::Select;
use POSIX qw(setsid setpgid WNOHANG);
use Time::HiRes qw(time sleep);
use strict;

our $NAME = 'ncrtagentdaemon';
our $LOGFILE  = '/var/log/naemon/ncrtagentdaemon.log';
our $WORKDIR;
our $PING_RENEWAL_SEC = 900;
our $PONG_EXPIRATION_SEC = 180;

####
our $LOGFH = *STDERR;
our $DEBUG = 0;

sub reopen_log () {
	if( open my $h, '>>', $LOGFILE ){
		$h->autoflush;
		$LOGFH = $h;
	}else{
		$LOGFH = *STDERR;
	}
}

sub debuglog ($;@) {
	return unless $DEBUG;
	my ($format, @args) = @_;
	my ($sec,$min,$hour,$day,$mon,$year) = localtime time;
	my $t = sprintf '%04d-%02d-%02d_%02d:%02d:%02d', $year+1900, $mon+1, $day, $hour, $min, $sec;
	printf $LOGFH "$t $format\n", @args;
}

sub accesslog ($;@) {
	my ($format, @args) = @_;
	my ($sec,$min,$hour,$day,$mon,$year) = localtime time;
	my $t = sprintf '%04d-%02d-%02d_%02d:%02d:%02d', $year+1900, $mon+1, $day, $hour, $min, $sec;
	printf $LOGFH "$t $format\n", @args;
}

sub var2ltsv ( \% ){
	my ($var) = @_;
	my @ltsv;
	push @ltsv, "host_service:".$var->{host_service} if defined $var->{host_service};
	foreach my $k ( sort {$a cmp $b} keys %$var ){
		next if $k eq 'host_service';
                push @ltsv, "$k:".$var->{$k};
	}
	return join "\t", @ltsv;
}

sub ltsv2var ( $ ){
	my ($ltsv) = @_;
	my %var;
	foreach my $kv ( split m"\t", $ltsv ){
		$kv =~ m"^([^[:cntrl:]\s:;=]+)[:=](.*)$" or do {
			next;
		};
		my $k = $1;
		my $v = $2;
		$var{$k} = $v;
	}
	return %var;
}

####
sub compile_allow ($) {
	my ($allow) = @_;
	my @allow;
	foreach my $subnet ( split m",", $allow ){
		if( $subnet =~ m"^(\d+\.\d+\.\d+\.\d+)/(\d+)$" ){
			my $addr = $1;
			my $netbit = $2;
			my $bin_netmask = pack 'V1',
				pack('b*', "1"x$netbit . "0"x(32-$netbit));
			my $bin_addr = inet_aton $addr;
			my $bin_subnet = $bin_addr & $bin_netmask;
			push @allow, [$bin_subnet, $bin_netmask];
		}elsif( $subnet =~ m"^(\d+\.\d+\.\d+\.\d+)$" ){
			my $bin_netmask = inet_aton '255.255.255.255';
			my $bin_addr = inet_aton $subnet;
			push @allow, [$bin_addr, $bin_netmask];
		}
	}
	return @allow;
}

sub check_allow ($@) {
	my ($bin_addr, @allow) = @_;
	foreach my $subnet_netmask ( @allow ){
		if( $$subnet_netmask[0] eq ($bin_addr & $$subnet_netmask[1]) ){
			return 1;
		}
	}
	return undef;
}

sub setup_workdir () {
	if( $ENV{'HOME'} ){ $WORKDIR = $ENV{'HOME'} . "/.ncrt"; }
	else{
        	my ($name, $pw, $uid, $gid, $quota, $comment, $gcos,
		    $home, $shell, $expire ) = getpwuid $<;
        	$WORKDIR = "$home/.ncrt";
	}
	unless( -d $WORKDIR ){
		mkdir $WORKDIR or die "$WORKDIR: cannot create, stopped";
 	}
}

sub setup_workdir_of ($) {
	my ($daemon_user) = @_;
	unless( defined $daemon_user and $daemon_user ne '' ){
		setup_workdir;
		return;
	}
	my ($name, $pw, $uid, $gid, $quota, $comment, $gcos,
	    $home, $shell, $expire ) = getpwnam $daemon_user;
	if    ( $< != $uid ){
		$WORKDIR = "$home/.ncrt";
	}elsif( $ENV{'HOME'} ne "" ){
		$WORKDIR = $ENV{'HOME'} . "/.ncrt";
	}else{
		$WORKDIR = "$home/.ncrt";
	}
}

sub read_conf () {
	my %conf = (
		'listen_address' => '0.0.0.0',
		'listen_port' => 46848,
		'daemon_user' => undef,
		'DEBUG' => 0,
	);

	my $conffile = "$DAEMONCONFDIR/ncrtagentdaemon.conf";
	open my $h, '<', $conffile or do {
		die "cannot open $conffile: $OS_ERROR, stopped";
	};
	while (<$h>) {
		next if m"^\s*(#|$)";
		die "$conffile:$.: illegal format, stopped" unless m"^(\w+)=(.*)$";
		$conf{$1} = $2;
	}
	close $h or do {
		die "close failed for $conffile: $OS_ERROR, stopped";
	};
	return \%conf;
}

sub read_command ($) {
	my ($cmd) = @_;

	#my $out, my $in;
	my $pid = open2 my $out, my $in, $cmd;
	close $in;

	my @messages;
	my %metrics;
	while( <$out> ){
		chomp;
		next if m"^\s*(#|$)";
		die "$_, stopped" unless m"^([^[:cntrl:]\s:;=]+)=(.*)$";
		my $k = $1;
		my $v = $2;
		if( $k eq 'message' ){ push @messages, $v; }
		elsif( $v =~ m"^([-+]?\d+(?:\.\d+)?)([%a-zA-Z]*)$" ){
			$metrics{$k} = $v;
		}
	}
	close $out;

	waitpid $pid, 0;
	my $plugin_rc = $? >> 8;
	my $ok = 1;
	if( $plugin_rc > 0 ){
		push @messages, "plugin_rc:$plugin_rc";
		$ok = undef;
	}
	return $ok, \%metrics, \@messages;
}

sub write_pidfile ($) {
	my ($pid) = @_;
	my $f = "$WORKDIR/ncrtagentdaemon.pid";
	open my $h, '>', $f or die;
	print $h "$pid\n";
	close $h;
}

sub read_pidfile () {
	my $f = "$WORKDIR/ncrtagentdaemon.pid";
	open my $h, '<', $f or return undef;
	my $pid = int <$h>;
	close $h;
	return undef unless $pid > 1;
	# check the process existence.
	return undef unless kill 0, $pid;
	# check the process name.
	open my $h, "<", "/proc/$pid/cmdline" or return undef;
	my $cmd = <$h>;
	close $h;
	return undef unless $cmd =~ m"^(\S*/)?(\w+)";
	return undef unless $2 eq $NAME;
	return $pid;
}

####
sub action_measure ($$$$$) {
	my ($conf, $conn, $measure, $host, $service) = @_;
	my $cmd = "$PLUGINSDIR/ncrtagent_linux_${measure} $PLUGINSCONFDIR $WORKDIR $measure $host $service";
	my ($ok, $metrics, $messages) = read_command $cmd;

	my $content;
	foreach my $k ( sort keys %$metrics ){
		my $v = $$metrics{$k};
		$content .= "$k=$v\n";
	}
	foreach my $v ( @$messages ){
		$content .= "message=$v\n";
	}

	my $res = HTTP::Response->new;
	if( $ok ){ $res->code(200); }
	else     { $res->code(500); }
	$res->header('Content-Type' => 'text/plain');
	$res->content($content);
	$conn->send_response($res);
}

sub action_ping ($$) {
	my ($conf, $conn) = @_;
	my $res = HTTP::Response->new;
	$res->code(200);
	$res->header('Content-Type' => 'text/plain');
	$res->content("OK\n");
	$conn->send_response($res);
}


####
sub cmd_cron ($) {
	my ($conf) = @_;
}

sub keep_child_daemon ($$) {
	my ($conf, $d) = @_;
	$0 = "$NAME [child]";
	setpgid 0, 0 or die "setpgid: $OS_ERROR, stopped";
	my @allow = compile_allow( $$conf{allow} // "0.0.0.0/0" );
	my $stopping = 0;
	my $ping_pending = 0;
	my $parent_pid = getppid;
	$SIG{'TERM'} = sub {
		$stopping = 1;
		$d->close;
	};
	$SIG{'HUP'} = sub { reopen_log; };
	$SIG{'CHLD'} = 'IGNORE';
	$SIG{'USR1'} = sub { $ping_pending = 1; };
	my $select = IO::Select->new($d);

	while( not $stopping ){
		# Reply from the request loop, not a signal handler, to detect stalled I/O.
		if( $ping_pending ){
			last unless kill 'USR1', $parent_pid;
			$ping_pending = 0;
		}
		last if getppid != $parent_pid;
		next unless $select->can_read(1);
		last if $stopping;
		my ($conn, $peer_addr) = $d->accept;
		next unless $conn;
		my $req = $conn->get_request;
		unless( $req ){
			$conn->close;
			next;
		}
		my $method = $req->method;
		my $path = uri_unescape $req->uri->path;
		my ($port, $bin_addr) = unpack_sockaddr_in $peer_addr;
		my $addr = inet_ntoa $bin_addr;
		accesslog 'req: client=%s:%d method=%s path=%s',
			$addr, $port, $method, $path;

		unless( check_allow $bin_addr, @allow ){
			accesslog 'error: denied.';
			$conn->send_error(RC_FORBIDDEN);
			$conn->close;
			undef $conn;
			next;
		}

		if( $path =~ m"^/measure/([-\w]+)/([-\w.]+)/([-\w]+)" ){
			my $measure = $1;
			my $host = $2;
			my $service = $3;
			my $pid = fork;
			if( not defined $pid ){
				accesslog 'cannot fork measurement: %s', $OS_ERROR;
				$conn->send_error(RC_INTERNAL_SERVER_ERROR);
			}elsif( $pid == 0 ){
				$d->close;
				$SIG{'CHLD'} = 'DEFAULT';
				$SIG{'TERM'} = 'DEFAULT';
				$SIG{'USR1'} = 'IGNORE';
				action_measure $conf, $conn,
					$measure, $host, $service;
				exit 0;
			}
		}elsif( $path =~ m"^/ping" ){
			action_ping $conf, $conn;
		}else{
			$conn->send_error(RC_FORBIDDEN);
		}
		$conn->close;
		undef $conn;
	}
}

sub stop_child_from_parent ($) {
	my ($pid) = @_;
	return unless defined $pid;
	kill 'TERM', -$pid;
	my $deadline = time + 10;
	while( time < $deadline ){
		my $exited = waitpid $pid, WNOHANG;
		if( $exited == $pid or $exited == -1 ){
			kill 'KILL', -$pid;
			return;
		}
		sleep 0.1;
	}
	kill 'KILL', -$pid;
	$deadline = time + 10;
	while( time < $deadline ){
		my $exited = waitpid $pid, WNOHANG;
		return if $exited == $pid or $exited == -1;
		sleep 0.1;
	}
	accesslog 'child %d did not exit after KILL; detaching', $pid;
}

sub keep_parent_daemon ($$$) {
	my ($conf, $d, $ready) = @_;
	my $stopping = 0;
	my $reload = 0;
	my $pong_received = 0;
	$SIG{'TERM'} = sub { $stopping = 1; };
	$SIG{'HUP'} = sub { $reload = 1; };
	$SIG{'USR1'} = sub { $pong_received = 1; };
	$SIG{'CHLD'} = sub {};
	print $ready "READY\n";
	close $ready;
	my ($child_pid, $last_ping_time, $ping_sent);

	while( not $stopping ){
		while( (my $exited = waitpid -1, WNOHANG) > 0 ){
			if( defined $child_pid and $exited == $child_pid ){
				accesslog 'child %d exited (status %d); restarting', $exited, $?;
				kill 'KILL', -$child_pid;
				$child_pid = undef;
			}
		}
		if( $reload ){
			reopen_log;
			kill 'HUP', $child_pid if defined $child_pid;
			$reload = 0;
		}
		unless( defined $child_pid ){
			my $pid = fork;
			unless( defined $pid ){
				accesslog 'cannot fork child: %s', $OS_ERROR;
				sleep 1;
				next;
			}
			if( $pid == 0 ){
				eval { keep_child_daemon $conf, $d; };
				accesslog 'child error: %s', $@ if $@;
				exit($@ ? 1 : 0);
			}
			setpgid $pid, $pid;
			$child_pid = $pid;
			accesslog 'started child %d', $child_pid;
			$last_ping_time = time;
			$ping_sent = $pong_received = 0;
		}
		if( $ping_sent ){
			if( $pong_received ){
				$ping_sent = 0;
				debuglog 'received pong from child %d', $child_pid;
			}elsif( time >= $last_ping_time + $PONG_EXPIRATION_SEC ){
				accesslog 'child %d did not respond to ping; restarting', $child_pid;
				stop_child_from_parent $child_pid;
				$child_pid = undef;
				next;
			}
		}elsif( time >= $last_ping_time + $PING_RENEWAL_SEC ){
			$pong_received = 0;
			kill 'USR1', $child_pid;
			$last_ping_time = time;
			$ping_sent = 1;
			debuglog 'sent ping to child %d', $child_pid;
		}
		sleep 1 unless $stopping;
	}
	stop_child_from_parent $child_pid;
	$d->close;
}

sub cmd_daemon ($) {
	my ($conf) = @_;
	my $daemon_user = $$conf{daemon_user};
	if( $daemon_user ne '' ){
		my ($name, $pw, $uid, $gid, $quota, $comment, $gcos,
		    $home, $shell) = getpwnam $daemon_user;
		unless( defined $uid and defined $gid ){
			die "setuid: $daemon_user: not found, stopped";
		}
		$( = $gid unless $( == $gid;
		$) = $gid unless $) == $gid;
		$< = $uid unless $< == $uid;
		$> = $uid unless $> == $uid;
		$ENV{HOME} = $home;
	}
	setup_workdir;
	die "pid found, stopped" if read_pidfile;
	$LOGFILE = "$WORKDIR/ncrtagentdaemon.log";
	reopen_log;
	my $d = HTTP::Daemon->new(
		'ReuseAddr' => 1,
		'LocalAddr' => $$conf{listen_address},
		'LocalPort' => $$conf{listen_port}
	) or die sprintf 'cannot listen %s:%d: %s, stopped',
		$$conf{listen_address}, $$conf{listen_port}, $OS_ERROR;

	pipe my $ready, my $notify or die "pipe: $OS_ERROR, stopped";
	my $pid = fork;
	die "fork: $OS_ERROR, stopped" unless defined $pid;
	if( $pid != 0 ){
		close $notify;
		$d->close;
		my $status = <$ready>;
		close $ready;
		unless( defined $status and $status eq "READY\n" ){
			waitpid $pid, 0;
			die "daemon startup failed; see $LOGFILE, stopped";
		}
		return;
	}
	close $ready;
	$0 = $NAME;
	setsid() >= 0 or die "setsid: $OS_ERROR, stopped";
	open STDIN, '<', '/dev/null' or die;
	open STDOUT, '>', '/dev/null' or die;
	open STDERR, '>', '/dev/null' or die;
	write_pidfile $$;
	eval { keep_parent_daemon $conf, $d, $notify; };
	my $error = $@;
	accesslog 'parent error: %s', $error if $error;
	unlink "$WORKDIR/ncrtagentdaemon.pid";
	exit($error ? 1 : 0);
}

sub cmd_alive ($) {
	my ($conf) = @_;
	my $pid = read_pidfile;
	exit 1 unless defined $pid;
}

sub cmd_kill ($) {
	my ($conf) = @_;
	my $pid = read_pidfile;
	exit 1 unless defined $pid;
	kill 'TERM', $pid;
	my $deadline = time + 25;
	while( time < $deadline ){
		exit 0 unless defined read_pidfile;
		sleep 0.1;
	}
	exit 1;
}

sub cmd_hup ($) {
	my ($conf) = @_;
	my $pid = read_pidfile;
	exit 1 unless defined $pid;
	kill 'HUP', $pid;
}


####
my $conf = read_conf;
$DEBUG = $conf->{DEBUG};


####
if    ( $ARGV[0] eq "daemon" ){
	# setup workdir after fork.
	cmd_daemon $conf;
	exit 0;
}elsif( $ARGV[0] eq "alive" ){
	my $daemon_user = $$conf{daemon_user};
	setup_workdir_of $daemon_user;
	cmd_alive $conf;
	exit 0;
}elsif( $ARGV[0] eq "kill" ){
	my $daemon_user = $$conf{daemon_user};
	setup_workdir_of $daemon_user;
	cmd_kill $conf;
	exit 0;
}elsif( $ARGV[0] eq "hup" ){
	my $daemon_user = $$conf{daemon_user};
	setup_workdir_of $daemon_user;
	cmd_hup $conf;
	exit 0;
}elsif( $ARGV[0] eq "cron" ){
	setup_workdir;
	cmd_cron $conf;
	exit 0;
}else{
	print "usage: % $0 {daemon|cron}\n";
	exit 0;
}
